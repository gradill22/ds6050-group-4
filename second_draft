    "def make_transform(normalization, augmentation, train):\n",
    "    picture_steps, tensor_steps = get_augmentation(augmentation) if train else ([], [])\n",
    "    return transforms.Compose(\n",
    "        [transforms.Grayscale(num_output_channels=1), transforms.Resize((128, 128))]\n",
    "        + picture_steps\n",
    "        + [transforms.ToTensor()]\n",
    "        + tensor_steps\n",
    "        + [get_normalization(normalization)]\n",
    "    )\n",
    "\n",
    "def make_loaders(normalization, augmentation, seed):\n",
    "    # Training data is augmented, validation data is not, but both are loaded from the same folder\n",
    "    train_data = Subset(datasets.ImageFolder(train_dir, make_transform(normalization, augmentation, True)), train_indices)\n",
    "    val_data = Subset(datasets.ImageFolder(train_dir, make_transform(normalization, \"none\", False)), val_indices)\n",
    "    test_data = datasets.ImageFolder(test_dir, make_transform(normalization, \"none\", False)) # The testing folder is only used for the final evaluation\n",
    "\n",
    "    generator = torch.Generator()\n",
    "    generator.manual_seed(seed)\n",
    "\n",
    "    # shuffle=True so each epoch will see the training image in a new order\n",
    "    train_loader = DataLoader(train_data, batch_size=64, shuffle=True, generator=generator)\n",
    "    val_loader = DataLoader(val_data, batch_size=64)\n",
    "    test_loader = DataLoader(test_data, batch_size=64)\n",
    "    return train_loader, val_loader, test_loader"
   ]
