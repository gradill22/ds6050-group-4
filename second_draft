    "### The Decision Rule\n",
    "* An augmented model is better than the baseline if its mean Macro F1 exceeds the baseline's by more than the lager of two SDs across seeds\n",
    "* If the differences fall within this range, then we claim that the models are performing similarly"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4efeda62",
   "metadata": {},
   "outputs": [],
   "source": [
    "def compare_models(name_a, name_b):\n",
    "    difference = means.loc[name_a, \"test_macro_f1\"] - means.loc[name_b, \"test_macro_f1\"]\n",
    "    margin = max(stds.loc[name_a, \"test_macro_f1\"], stds.loc[name_b, \"test_macro_f1\"]) # the larger std\n",
    "\n",
    "    if difference > margin:\n",
    "        verdict = f\"{name_a} is BETTER\"\n",
    "    elif difference < -margin:\n",
    "        verdict = f\"{name_a} is WORSE\"\n",
    "    else:\n",
    "        verdict = \"EQUIVALENT (within the margin)\"\n",
    "    return difference, margin, verdict\n",
    "\n",
    "# Augmentation study: each augmented model vs the baseline, and Model 4 vs Models 2 and 3\n",
    "augmentation_comparisons = [\n",
    "    (\"model2_geometric_intensity\",    \"model1_baseline\"),\n",
    "    (\"model3_noise_blur_compression\", \"model1_baseline\"),\n",
    "    (\"model4_combined\",               \"model1_baseline\"),\n",
    "    (\"model4_combined\",               \"model2_geometric_intensity\"),\n",
    "    (\"model4_combined\",               \"model3_noise_blur_compression\"),\n",
    "]\n",
    "# Normalization study: each normalization vs. no normalization\n",
    "normalization_comparisons = [\n",
    "    (\"model1_baseline\",              \"baseline_no_normalization\"),\n",
    "    (\"baseline_image_normalization\", \"baseline_no_normalization\"),\n",
    "    (\"baseline_image_normalization\", \"model1_baseline\"),\n",
    "]\n",
    "\n",
    "def decision_table(comparisons):\n",
    "    decision_rows = []\n",
    "    for name_a, name_b in comparisons:\n",
    "        if name_a in means.index and name_b in means.index: # only compare models that have finished runs (if incomplete)\n",
    "            difference, margin, verdict = compare_models(name_a, name_b)\n",
    "            decision_rows.append({\"A\": name_a, \"vs B\": name_b,\n",
    "                                  \"mean F1 difference (A - B)\": round(difference, 4),\n",
    "                                  \"margin (larger std)\": round(margin, 4),\n",
    "                                  \"verdict\": verdict})\n",
    "    return pd.DataFrame(decision_rows)\n",
    "\n",
    "print(\"Augmentation study - decision rule on test macro-F1:\")\n",
    "display(decision_table(augmentation_comparisons))\n",
    "print(\"Normalization study - decision rule on test macro-F1:\")\n",
    "display(decision_table(normalization_comparisons))"
   ]
