   ],
   "source": [
    "# Deffining the Residual Block:\n",
    "class resBlock(nn.Module):\n",
    "    def __init__(self, in_channels, out_channels, stride=1):\n",
    "        super(resBlock, self).__init__()\n",
    "        # We included a \"stride on the first conv of the second/third stages (it halves the image size)\n",
    "        self.first_conv = nn.Conv2d(in_channels, out_channels, 3, padding=1, stride=stride, bias=False)\n",
    "        # apply the batchnorm\n",
    "        self.bn1 = nn.BatchNorm2d(out_channels)\n",
    "        # apply activation function\n",
    "        self.relu = nn.ReLU(inplace=True)\n",
    "        self.second_conv = nn.Conv2d(out_channels, out_channels, 3, padding=1, stride=1, bias=False)\n",
    "        # apply the second batchnorm\n",
    "        self.bn2 = nn.BatchNorm2d(out_channels)\n",
    "        # building the skip connection with a check for any size mismatches\n",
    "        self.shortcut = nn.Sequential()\n",
    "        if stride != 1 or in_channels != out_channels:\n",
    "            self.shortcut = nn.Sequential(\n",
    "                nn.Conv2d(in_channels, out_channels, kernel_size=1, stride=stride),\n",
    "                nn.BatchNorm2d(out_channels)\n",
    "            )\n",
    "\n",
    "    def forward(self, x):\n",
    "        # pass x through first conv layer, normalize, apply relu\n",
    "        holder = self.relu(self.bn1(self.first_conv(x)))\n",
    "        # apply second conv layer and normalize\n",
    "        holder = self.bn2(self.second_conv(holder))\n",
    "        # skip connection, then return the final value after relu\n",
    "        return self.relu(holder + self.shortcut(x))\n",
    "\n",
    "\n",
    "class BrainTumorCNN(nn.Module):\n",
    "    # in_channel = 1 because the images are grayscale\n",
    "    def __init__(self, num_classes=4, in_channel=1):\n",
    "        super(BrainTumorCNN, self).__init__()\n",
    "\n",
    "        # 3x3 convolution with 32 channels\n",
    "        self.start_block = nn.Sequential(\n",
    "            nn.Conv2d(in_channel, 32, kernel_size=3, padding=1, bias=False),\n",
    "            nn.BatchNorm2d(32),\n",
    "            nn.ReLU(inplace=True)\n",
    "        )\n",
    "        # Three stages, each made of two residual blocks.\n",
    "        self.stage1 = nn.Sequential(resBlock(32, 32), resBlock(32, 32)) # 32 channels, size unchanged\n",
    "        self.stage2 = nn.Sequential(resBlock(32, 64, stride=2), resBlock(64, 64)) # 64 channels, size halved\n",
    "        self.stage3 = nn.Sequential(resBlock(64, 128, stride=2), resBlock(128, 128)) # 128 channels, size halved again\n",
    "\n",
    "        # Global average pooling; this averages each feature map down to a single number\n",
    "        self.avgpool = nn.AdaptiveAvgPool2d((1, 1))\n",
    "        # Final layer: 128 numbers that produce one score per class (4 tumor categories)\n",
    "        self.fc = nn.Linear(128, num_classes)\n",
    "\n",
    "    def forward(self, x):\n",
    "        holder = self.start_block(x)\n",
    "        holder = self.stage1(holder)\n",
    "        holder = self.stage2(holder)\n",
    "        holder = self.stage3(holder)\n",
    "        holder = self.avgpool(holder)\n",
    "        holder = torch.flatten(holder, 1)\n",
    "        return self.fc(holder)\n",
    "\n",
    "\n",
    "# Check that the model ran and has ~700K trainable parameters\n",
    "test_net = BrainTumorCNN()\n",
    "print(\"Output shape:\", test_net(torch.zeros(2, 1, 128, 128)).shape) # we expect: [2, 4]\n",
    "print(f\"Trainable parameters: {sum(p.numel() for p in test_net.parameters() if p.requires_grad):,}\")"
   ]
