    "## The Normalization Methods\n",
    "* **None:** the image stays as is (values between 0 and 1)\n",
    "* **Dataset:** every image uses the same training-set mean and std\n",
    "* **Image:** every image is rescaled using its own mean and std"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "adf320d8",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Methods for normalizing images: none, dataset, or image\n",
    "class ImageNormalization:\n",
    "    def __call__(self, image):\n",
    "        mean = image.mean(dim=(1, 2), keepdim=True)\n",
    "        std = image.std(dim=(1, 2), keepdim=True, unbiased=False)\n",
    "        return (image - mean) / (std + 1e-6) # avoid zero division\n",
    "\n",
    "# Matches the normalization method string to the corresponding transform\n",
    "def get_normalization(method):\n",
    "    if method == \"none\":\n",
    "        return transforms.Lambda(lambda image: image) # None\n",
    "    elif method == \"dataset\":\n",
    "        return transforms.Normalize(mean=training_mean, std=training_std) # Dataset\n",
    "    elif method == \"image\":\n",
    "        return ImageNormalization() # Image\n",
    "    else:\n",
    "        raise ValueError(\"Unknown normalization method\") # just in case of method name mistype"
   ]
