    "### Training each model:\n",
    "* Normalization\n",
    "* Augmentation \n",
    "* Seed\n",
    "\n",
    "### Settings:\n",
    "* Adam\n",
    "* Batch size = 64\n",
    "* Cross-Entropy loss\n",
    "* Early Stopping"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "736af5ea",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Trains one model for each normalization x augmentation x seed combo and returns its scores with the settings notesd above\n",
    "def run_experiment(normalization, augmentation, seed, max_epochs=60, patience=5, learning_rate=1e-3):\n",
    "\n",
    "    # Make it repeatable\n",
    "    set_seed(seed)\n",
    "\n",
    "    # Build the data for experiment normalization x augmentation choice\n",
    "    train_loader, val_loader, test_loader = make_loaders(normalization, augmentation, seed)\n",
    "\n",
    "    # Fresh model, loss function, optimizer (identical settings for every model so the comparison is fair)\n",
    "    net = BrainTumorCNN(num_classes=len(class_names), in_channel=1).to(device)\n",
    "    criterion = nn.CrossEntropyLoss()\n",
    "    optimizer = torch.optim.Adam(net.parameters(), lr=learning_rate)\n",
    "    early_stopper = MacroF1EarlyStopping(patience=patience)\n",
    "\n",
    "    for epoch in range(1, max_epochs + 1):\n",
    "\n",
    "        # ---- training pass ----\n",
    "        net.train()\n",
    "        train_loss, train_total = 0.0, 0\n",
    "        for images, labels in train_loader:\n",
    "            images, labels = images.to(device), labels.to(device)\n",
    "\n",
    "            optimizer.zero_grad()                  # clear old gradients\n",
    "            outputs = net(images)                  # make predictions\n",
    "            loss = criterion(outputs, labels)      # measure the error\n",
    "            loss.backward()                        # work out how to change each weight\n",
    "            optimizer.step()                       # update the weights\n",
    "\n",
    "            train_loss += loss.item() * images.size(0)\n",
    "            train_total += labels.size(0)\n",
    "\n",
    "        # ---- check progress on the VALIDATION split (never the test set) ----\n",
    "        val_loss, val_labels, val_predictions = evaluate(net, val_loader, criterion)\n",
    "        val_f1 = compute_metrics(val_labels, val_predictions)[\"macro_f1\"]\n",
    "        print(f\"    epoch {epoch:02d} | train loss {train_loss / train_total:.4f} \"\n",
    "              f\"| val loss {val_loss:.4f} | val macro-F1 {val_f1:.4f}\")\n",
    "\n",
    "        early_stopper(val_f1, net)\n",
    "        if early_stopper.early_stop:\n",
    "            print(f\"    early stopping: no validation macro-F1 improvement for {patience} epochs\")\n",
    "            break\n",
    "\n",
    "    # 4) Go back to the weights from the best epoch (not necessarily the last one)\n",
    "    net.load_state_dict(early_stopper.best_model_weights)\n",
    "\n",
    "    # 5) Final scores with the best weights. The test set is used ONCE, here.\n",
    "    _, val_labels, val_predictions = evaluate(net, val_loader, criterion)\n",
    "    val_metrics = compute_metrics(val_labels, val_predictions)\n",
    "    _, test_labels, test_predictions = evaluate(net, test_loader, criterion)\n",
    "    test_metrics = compute_metrics(test_labels, test_predictions)\n",
    "\n",
    "    # 6) Pack everything into a dictionary (one row of the results table)\n",
    "    outcome = {\n",
    "        \"validation_macro_f1\": float(val_metrics[\"macro_f1\"]),\n",
    "        \"test_macro_f1\": float(test_metrics[\"macro_f1\"]),\n",
    "        \"accuracy\": float(test_metrics[\"accuracy\"]),\n",
    "        \"epochs_trained\": epoch,\n",
    "        \"tumor_missed_rate\": float(test_metrics[\"tumor_missed_rate\"]),\n",
    "        # a matrix can't sit in one table cell, so store it as text (we turn it back into numbers later)\n",
    "        \"confusion_matrix\": json.dumps(test_metrics[\"confusion_matrix\"].tolist())\n",
    "    }\n",
    "    for i, name in enumerate(class_names):\n",
    "        outcome[f\"precision_{name}\"] = float(test_metrics[\"precision\"][i])\n",
    "        outcome[f\"recall_{name}\"] = float(test_metrics[\"recall\"][i])\n",
    "        outcome[f\"f1_{name}\"] = float(test_metrics[\"f1\"][i])\n",
    "    return outcome"
   ]
