   "source": [
    "# Adds random 'static' to an image tensor, values will be within 0-1\n",
    "class AddGaussianNoise:\n",
    "    def __init__(self, std=0.02, p=0.5):\n",
    "        self.std = std # how strong the noise is\n",
    "        self.p = p # probability that noise is applied to an image\n",
    "\n",
    "    def __call__(self, image):\n",
    "        if random.random() > self.p: # gives a number within 0-1; if it's above p, it will skip the noise this time\n",
    "            return image\n",
    "        noisy = image + torch.randn_like(image) * self.std # adds random values from a bell curve\n",
    "        return noisy.clamp(0.0, 1.0) # keeps pixel values within 0-1\n",
    "\n",
    "# Adding compression by randomly saving the image as a low-quality JPEG and reloading it\n",
    "class RandomJPEGCompression:\n",
    "    def __init__(self, quality_range=(30, 95), p=0.5):\n",
    "        self.quality_range = quality_range # lower quality = more visible compression damage\n",
    "        self.p = p\n",
    "\n",
    "    def __call__(self, image):\n",
    "        if random.random() > self.p:\n",
    "            return image\n",
    "        quality = random.randint(*self.quality_range) # pick a random quality level\n",
    "        buffer = io.BytesIO()\n",
    "        image.save(buffer, format=\"JPEG\", quality=quality)\n",
    "        buffer.seek(0) # go back to the start so we can read it back\n",
    "        return Image.open(buffer).convert(image.mode) # reload, keeping the same mode\n",
    "\n",
    "# Return the two lists of steps for the specific augmentation method\n",
    "def get_augmentation(method):\n",
    "    # Model 2: shifts, rotations, brightness and contrast\n",
    "    geometric_intensity = [\n",
    "        # degrees=10 -> rotate by a random angle between -10 and +10\n",
    "        # translate=(0.05, 0.05) -> shift by up to 5% of the width/height\n",
    "        transforms.RandomAffine(degrees=10, translate=(0.05, 0.05)),\n",
    "        transforms.ColorJitter(brightness=0.2, contrast=0.2),\n",
    "    ]\n",
    "    # Model 3: blur and JPEG compression on the picture; noise on the tensor\n",
    "    noise_blur_picture_steps = [\n",
    "        transforms.RandomApply([transforms.GaussianBlur(kernel_size=5, sigma=(0.1, 1.5))], p=0.5),\n",
    "        RandomJPEGCompression(quality_range=(30, 95), p=0.5),\n",
    "    ]\n",
    "    noise_tensor_steps = [AddGaussianNoise(std=0.02, p=0.5)]\n",
    "\n",
    "    if method == \"none\":\n",
    "        return [], []\n",
    "    elif method == \"geometric_intensity\":\n",
    "        return geometric_intensity, []\n",
    "    elif method == \"noise_blur_compression\":\n",
    "        return noise_blur_picture_steps, noise_tensor_steps\n",
    "    elif method == \"combined\":\n",
    "        return geometric_intensity + noise_blur_picture_steps, noise_tensor_steps\n",
    "    else:\n",
    "        raise ValueError(f\"Unknown augmentation method: {method}\")"
   ]
  },
