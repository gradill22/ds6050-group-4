    "# Runs the model over a DataLoader and returns the average loss plus every true label and prediction\n",
    "def evaluate(net, loader, criterion):\n",
    "    net.eval() # evaluation\n",
    "    running_loss = 0.0\n",
    "    all_predictions = [] # keeping all predictions\n",
    "    all_labels = [] # and every label\n",
    "\n",
    "    with torch.no_grad(): # decided not to keep gradient tracking\n",
    "        for images, labels in loader:\n",
    "            images, labels = images.to(device), labels.to(device)\n",
    "            outputs = net(images)\n",
    "            running_loss += criterion(outputs, labels).item() * images.size(0)\n",
    "            all_predictions.extend(outputs.argmax(dim=1).cpu().tolist()) # class with the highest score\n",
    "            all_labels.extend(labels.cpu().tolist())\n",
    "\n",
    "    return running_loss / len(all_labels), all_labels, all_predictions\n",
    "\n",
    "\n",
    "# Turns lists of labels + predictions into the metrics of interest:\n",
    "def compute_metrics(labels, predictions):\n",
    "    class_ids = list(range(len(class_names)))      # [0, 1, 2, 3]\n",
    "\n",
    "    accuracy = accuracy_score(labels, predictions) * 100.0\n",
    "    macro_f1 = f1_score(labels, predictions, average=\"macro\", labels=class_ids, zero_division=0) # one precision / recall / F1 value per class\n",
    "    precision, recall, f1, _ = precision_recall_fscore_support(labels, predictions, labels=class_ids, zero_division=0)\n",
    "    matrix = confusion_matrix(labels, predictions, labels=class_ids) # rows = true class, columns = predicted class\n",
    "\n",
    "    # Tumor predicted as no tumor when there was a tumor\n",
    "    no_tumor_id = class_names.index(\"notumor\")\n",
    "    tumor_ids = [i for i in class_ids if i != no_tumor_id]\n",
    "    tumor_missed_rate = 100.0 * matrix[tumor_ids, no_tumor_id].sum() / matrix[tumor_ids, :].sum()\n",
    "\n",
    "    return {\"accuracy\": accuracy, \"macro_f1\": macro_f1, \"precision\": precision, \"recall\": recall,\n",
    "            \"f1\": f1, \"confusion_matrix\": matrix, \"tumor_missed_rate\": tumor_missed_rate}\n",
    "\n",
    "\n",
    "# Early stopping: Stops training when validation macro-F1 hasn't improved for 5 epochs in a row\n",
    "class MacroF1EarlyStopping:\n",
    "    def __init__(self, patience=5, min_delta=0.0):\n",
    "        self.patience = patience\n",
    "        self.min_delta = min_delta # how much the score must rise to count as an improvement\n",
    "        self.counter = 0 # epochs in a row without improvement\n",
    "        self.best_f1 = -1.0 # start below any possible score\n",
    "        self.early_stop = False # becomes True when it's time to stop\n",
    "        self.best_model_weights = None # copy of the model's weights from the best epoch\n",
    "\n",
    "    def __call__(self, val_f1, net):\n",
    "        if val_f1 > self.best_f1 + self.min_delta:\n",
    "            # Improvement: remembers this score and keeps a copy of the weights\n",
    "            self.best_f1 = val_f1\n",
    "            self.counter = 0\n",
    "            self.best_model_weights = copy.deepcopy(net.state_dict())\n",
    "        else:\n",
    "            # No improvement: countsit, and stops once we run out of 5 epochs in a row without improvement\n",
    "            self.counter += 1\n",
    "            if self.counter >= self.patience:\n",
    "                self.early_stop = True"
   ]
