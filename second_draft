   "source": [
    "fig, (left_axis, right_axis) = plt.subplots(1, 2, figsize=(15, 5))\n",
    "\n",
    "# Left: test macro-F1 per model (Bars = mean, black lines = ±1 std, dots = individual seeds)\n",
    "left_axis.bar(experiment_order, means.loc[experiment_order, \"test_macro_f1\"],\n",
    "              yerr=stds.loc[experiment_order, \"test_macro_f1\"], capsize=5, alpha=0.7)\n",
    "for position, name in enumerate(experiment_order):\n",
    "    seed_scores = done.loc[done[\"experiment\"] == name, \"test_macro_f1\"]\n",
    "    left_axis.scatter([position] * len(seed_scores), seed_scores, color=\"black\", zorder=3, s=15)\n",
    "left_axis.set_ylabel(\"Test macro-F1\")\n",
    "left_axis.set_title(\"Macro-F1 by model\")\n",
    "plt.setp(left_axis.get_xticklabels(), rotation=30, ha=\"right\")\n",
    "left_axis.set_ylim(max(0, float(done[\"test_macro_f1\"].min()) - 0.05), 1.0) # zooming the y-axis so small differences are more visible\n",
    "\n",
    "# Right: per-class F1 (one group of bars per class)\n",
    "bar_width = 0.8 / len(experiment_order)\n",
    "for model_number, name in enumerate(experiment_order):\n",
    "    heights = [means.loc[name, f\"f1_{c}\"] for c in class_names]\n",
    "    errors = [stds.loc[name, f\"f1_{c}\"] for c in class_names]\n",
    "    positions = [i + model_number * bar_width for i in range(len(class_names))]\n",
    "    right_axis.bar(positions, heights, width=bar_width, yerr=errors, capsize=3, label=name)\n",
    "right_axis.set_xticks([i + 0.4 - bar_width / 2 for i in range(len(class_names))])\n",
    "right_axis.set_xticklabels(class_names)\n",
    "right_axis.set_ylabel(\"Test F1\")\n",
    "right_axis.set_title(\"Per-class F1 by model\")\n",
    "right_axis.legend(fontsize=8)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"results_plots.png\", dpi=150)\n",
    "plt.show()"
   ]
